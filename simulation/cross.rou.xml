

<routes>

    <!-- Normal vehicle -->
    <vType id="car"
           vClass="passenger"
           accel="2.6"
           decel="4.5"
           sigma="0.5"
           length="5"
           maxSpeed="13.89"/>

    <!-- Emergency ambulance -->
    <vType id="ambulance"
           vClass="emergency"
           accel="3.5"
           decel="6.0"
           sigma="0"
           length="5.5"
           maxSpeed="22.22"
           color="1,0,0"/>

    <!-- Normal traffic routes -->
    <route id="north_south" edges="N_C C_S"/>
    <route id="south_north" edges="S_C C_N"/>
    <route id="east_west" edges="E_C C_W"/>
    <route id="west_east" edges="W_C C_E"/>

    <!-- Ambulance routes -->
    <route id="ambulance_NS" edges="N_C C_S"/>
    <route id="ambulance_SN" edges="S_C C_N"/>
    <route id="ambulance_EW" edges="E_C C_W"/>
    <route id="ambulance_WE" edges="W_C C_E"/>

    <!-- Normal traffic: 40 vehicles -->
    <flow id="flow_NS" type="car" route="north_south"
          begin="0" end="100" number="10"/>

    <flow id="flow_SN" type="car" route="south_north"
          begin="0" end="100" number="10"/>

    <flow id="flow_EW" type="car" route="east_west"
          begin="0" end="100" number="10"/>

    <flow id="flow_WE" type="car" route="west_east"
          begin="0" end="100" number="10"/>

    <!-- Emergency ambulance enters from East -->
    <vehicle id="ambulance_1"
             type="ambulance"
             route="ambulance_EW"
             depart="20"
             departLane="best"
             departSpeed="max"/>

</routes>
